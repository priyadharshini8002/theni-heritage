# Firebase configuration (all optional).
# The website runs fully without these — place suggestions simply fall
# back to localStorage instead of Firestore, and photo uploads are skipped.
#
# To enable Firebase:
# 1. Create a project at https://console.firebase.google.com
# 2. Enable Firestore (Native mode) and Storage
# 3. Copy your web app config values below
# 4. Rename this file to .env (Vite only reads .env, not .env.example)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Apps Script Web App URL for Profile > Feedback.
# Deploy google-apps-script/Code.gs as a Web App and paste its /exec URL here.
VITE_GOOGLE_APPS_SCRIPT_URL=
